# Opcional; padrão claude-opus-5-5
CLAUDE_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
# Preço do modelo GPT escolhido, em USD por milhão de tokens (para o registro de custo)
OPENAI_PRECO_ENTRADA_USD_MTOK=
OPENAI_PRECO_SAIDA_USD_MTOK=
